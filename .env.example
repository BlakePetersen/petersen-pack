# ============================================================
# Luna — environment variables
# Validated at build time via @t3-oss/env-nextjs (lib/env.ts)
# See https://env.t3.gg for schema shape
# ============================================================

# --- REQUIRED (app will not build without these) ---

# Database
# DATABASE_URL = pooled connection (Transaction mode) for app queries
# DIRECT_URL   = direct connection (Session mode) for Prisma migrations
DATABASE_URL="postgresql://user:password@localhost:5432/luna"
DIRECT_URL="postgresql://user:password@localhost:5432/luna"
# Supabase example:
# DATABASE_URL="postgresql://postgres.[ref]:[pw]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.[ref]:[pw]@aws-0-[region].pooler.supabase.com:5432/postgres"

# NextAuth 5 — secret for session JWT signing. Min 32 chars.
# Renamed from NEXTAUTH_SECRET in Phase 1 (PLT-10).
AUTH_SECRET="replace-with-32-plus-random-chars"

# Stripe — revenue path
STRIPE_SECRET_KEY="sk_test_..."

# Resend — transactional email
RESEND_API_KEY="re_..."

# From-address for outbound mail (must be verified in Resend)
FROM_EMAIL="noreply@ashleypetersenphoto.com"

# Public app URL (for absolute links, OAuth callbacks, etc.)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- OPTIONAL (feature-gated — may become required in Phase 2) ---

# Stripe webhook signature — becomes REQUIRED in Phase 2 SEC-08
STRIPE_WEBHOOK_SECRET=""

# Cloudinary (image delivery)
CLOUDINARY_URL=""

# Vercel Blob (image storage)
BLOB_READ_WRITE_TOKEN=""

# OpenAI (AI alt-tag generation) — https://platform.openai.com/api-keys
OPENAI_API_KEY=""

# Replicate (image upscaling) — https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=""

# --- OBSERVABILITY (consumed by P1.2 pino + Sentry wiring) ---

# Sentry DSN — if unset, Sentry SDK stays dormant
SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""

# Log level: trace|debug|info|warn|error|fatal (default: info)
LOG_LEVEL="info"

# Pretty-print logs: 1 for pino-pretty, 0 for JSON (default: 0)
LOG_PRETTY="0"

# --- RESERVED FOR PHASE 2 ---

# Field-level encryption key — used by Phase 2 P2.5 (SEC-04 gallery password encryption)
FIELD_ENCRYPTION_KEY=""

# --- CLIENT-SIDE (NEXT_PUBLIC_*) ---

# Google Analytics 4 Measurement ID — https://analytics.google.com
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"

# Google Search Console verification — https://search.google.com/search-console
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""

# --- LEGACY / NOT SCHEMA-VALIDATED ---
# These vars are referenced by existing code (tools/scripts, helper modules) but
# not declared in lib/env.ts. Phase 2 should consolidate or remove.

# NEXTAUTH_URL — NextAuth 5 auto-derives from request; kept for tooling compatibility.
NEXTAUTH_URL="http://localhost:3000"

# ADMIN_EMAIL — recipient for inquiry notifications.
ADMIN_EMAIL="admin@ashleypetersenphoto.com"


# --- Sentry ---
# NEXT_PUBLIC_SENTRY_DSN and SENTRY_DSN are SEPARATE vars by design:
#   - NEXT_PUBLIC_SENTRY_DSN: read by sentry.client.config.ts — reports browser
#     crashes. Bundled into the client, must be prefixed NEXT_PUBLIC_*.
#   - SENTRY_DSN: read by sentry.server.config.ts — reports server-side route
#     errors via instrumentation.ts. Server-only; never exposed to the browser.
# In practice, set BOTH to the same DSN value. If only one is set, the other
# surface will silently emit nothing (env schema keeps both optional so dev
# without Sentry still boots). Split exists so you *could* point server vs
# client at different Sentry projects, which is rare.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# Upstash Redis — distributed rate limiter (SEC-01, P2.2a). REQUIRED.
# Vercel Marketplace → Upstash integration auto-injects these in prod/preview.
# Local dev: `vercel env pull .env.local` populates from Vercel project settings,
# or set manually after creating an Upstash Redis database at console.upstash.com.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
