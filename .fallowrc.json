{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",

  // Pnpm + turbo monorepo. Next.js / package plugins discover most entry points;
  // velite.config.ts is run by Velite at build but isn't imported by app code,
  // so we mark it as an entry to keep its imports (shiki etc.) in the graph.
  "workspaces": {
    "packages": ["apps/*", "packages/*"]
  },
  "entry": ["apps/blakepetersen.io/velite.config.ts"],

  // Jest setupFilesAfterEnv references aren't traced through TS imports;
  // tell fallow these are loaded at runtime by the test framework.
  "dynamicallyLoaded": ["**/tests/setup.ts", "**/jest.setup.ts"],

  // Knip-compatible: don't report exports referenced in the same file as their
  // declaration. Some exports exist for module-shape clarity even though only
  // sibling functions in the same file consume them.
  "ignoreExportsUsedInFile": true,

  // Velite consumes content/**/*.mdx at build time via .velite/ collections.
  // Public assets and CalVer test fixtures are out of scope for static analysis.
  "ignorePatterns": [
    "apps/blakepetersen.io/content/**/*.mdx",
    "apps/blakepetersen.io/test-fixtures/**",
    "apps/blakepetersen.io/scripts/migrations/000-noop.ts",
    "**/public/**",
    "**/.velite/**",
    "**/dist/**",
    "**/.next/**"
  ],

  // Suppressed deps:
  //  - shiki / mdx / prism-react-renderer: type-only imports that resolve via
  //    transitive deps (@shikijs/rehype, @types/mdx) — real but tolerable.
  //  - blink-registry: workspace package builds to dist/, so fallow's resolver
  //    doesn't trace runtime imports back to source. The package is genuinely
  //    used (see packages/blink-cli/src/manifest.ts and apps/blakepetersen.io).
  //  - eslint-import-resolver-typescript: loaded implicitly by eslint-plugin-import-x's
  //    resolver setting ({ typescript: true }) — no direct import to trace.
  "ignoreDependencies": [
    "shiki",
    "mdx",
    "prism-react-renderer",
    "blink-registry",
    "eslint-import-resolver-typescript"
  ],

  // Severities: warn-everywhere so the first CI run doesn't fail. Flip to
  // "error" later once any remaining findings are addressed. Known persistent
  // warns: 2 unresolved-imports for `artax-ui/styles/globals.css` in app
  // globals.css files (Tailwind v4 workspace subpath; fallow's CSS resolver
  // doesn't follow `exports` map for CSS — non-blocking false positives).
  "rules": {
    "unused-files": "warn",
    "unused-exports": "warn",
    "unused-types": "warn",
    "unused-dependencies": "warn",
    "unlisted-dependencies": "warn",
    "unresolved-imports": "warn",
    "circular-dependencies": "error",
    "duplicate-exports": "error"
  }
}
