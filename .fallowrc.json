{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": ["scripts/**/*.{ts,mjs,js}", "tools/**/*.ts", "prisma/seed*.ts"],
  "ignorePatterns": [".storybook/**", "test-output.css"],
