{
  "name": "blakepetersen.io",
  "version": "0.0.0",
  "private": true,
  "author": "Blake Petersen",
  "license": "MIT",
  "dependencies": {
    "@octokit/rest": "^22.0.1",
    "@shikijs/rehype": "^4.0.2",
    "@shikijs/transformers": "^4.0.2",
    "@tailwindcss/postcss": "^4.2.2",
    "@vercel/analytics": "^2.0.1",
    "artax-ui": "workspace:*",
    "blink-registry": "workspace:^",
    "lucide-react": "^1.7.0",
    "next": "16.2.10",
    "next-themes": "0.4.6",
    "react": "19.2.4",
    "react-dom": "^19.2.4",
    "schema-dts": "^2.0.0",
    "tailwindcss": "^4.2.2"
  },
  "scripts": {
    "build": "next build --webpack",
    "postbuild": "pagefind --site .next/server/app --output-path public/pagefind",
    "clean": "rm -rf .next && rm -rf .turbo && rm -rf node_modules",
    "dev": "next dev --webpack",
    "lint": "eslint .",
    "lint:content": "node ../../packages/blink-cli/dist/cli.mjs lint --content-root content",
    "migrate": "tsx scripts/migrate-content.ts",
    "perf:baseline": "tsx scripts/perf-baseline.ts",
    "start": "next start",
    "test": "jest",
    "test:visual": "playwright test tests/visual",
    "test:visual:update": "playwright test tests/visual --update-snapshots",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "velite": "velite build"
  },
  "devDependencies": {
    "@blink/cli": "workspace:*",
    "@dagrejs/dagre": "^3.0.0",
    "@playwright/test": "^1.59.1",
    "@types/jest": "^30.0.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "jest": "30.3.0",
    "pagefind": "^1.4.0",
    "rehype-slug": "^6.0.0",
    "ts-jest": "^29.4.9",
    "tsconfig": "workspace:*",
    "tsx": "^4.21.0",
    "typescript": "6.0.2",
    "velite": "^0.3.1"
  }
}
