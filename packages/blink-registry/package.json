{
  "name": "@blink-dx/registry",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "Zod schemas and TypeScript types for the Blink DX registry",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/blakepetersen/petersen-group",
    "directory": "packages/blink-registry"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "pnpm run build",
    "test": "jest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "tsconfig": "*",
    "typescript": "5.9.3",
    "@types/jest": "^30.0.0",
    "jest": "30.2.0",
    "ts-jest": "^29.4.6"
  }
}
